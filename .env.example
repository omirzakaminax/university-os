# ---- Database ----------------------------------------------------------------------------------------------
# Connection used for ALL user data. It must be a role that does NOT bypass Row Level Security.
# Local dev role is created by db/local/00_supabase_shim.sql; on Supabase use a dedicated non-bypass role.
DATABASE_URL=postgres://app_server:app_server@localhost:54329/university_os

# Privileged connection: migrations, the LOCAL auth provider, account deletion. Never exposed to the browser.
DATABASE_ADMIN_URL=postgres://postgres@localhost:54329/university_os

# Set to 1 ONLY for local/test databases (applies db/local shim: fake `auth` schema + roles). NEVER on Supabase.
LOCAL_SHIM=1

# ---- Auth --------------------------------------------------------------------------------------------------
AUTH_PROVIDER=local
# Development only: show the password-reset link on screen (no email provider exists yet). Ignored in production.
AUTH_DEV_SHOW_RESET_LINK=1

# ---- AI (optional; the app works fully without it) -------------------------------------------------------------
# AI_PROVIDER=gemini | none
# GEMINI_API_KEY=            # server-side only; never sent to the browser
# GEMINI_MODEL_FAST=gemini-2.5-flash   # VERIFY against Google's current model list
# GEMINI_MODEL_SMART=                  # optional larger model for tutoring (not used yet)
# GEMINI_API_BASE=https://generativelanguage.googleapis.com
# AI_DAILY_REQUEST_LIMIT=30  # per user per UTC day; protects free-tier quotas
